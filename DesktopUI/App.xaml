<Application x:Class="DesktopUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Renkler: açık gri zemin; renk yalnızca durum ve alarm için kullanılır -->
        <SolidColorBrush x:Key="PageBrush" Color="#E9ECEF" />
        <SolidColorBrush x:Key="PanelBrush" Color="#F6F7F8" />
        <SolidColorBrush x:Key="LineBrush" Color="#C9CED4" />
        <SolidColorBrush x:Key="BarBrush" Color="#2F3640" />
        <SolidColorBrush x:Key="MutedBrush" Color="#6B7480" />
        <SolidColorBrush x:Key="OkBrush" Color="#2E7D32" />
        <SolidColorBrush x:Key="WarnBrush" Color="#E08E00" />
        <SolidColorBrush x:Key="BadBrush" Color="#C62828" />
        <SolidColorBrush x:Key="AlarmBackBrush" Color="#F6C9C9" />

        <Style x:Key="BarText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDE1E6" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Application.Resources>
</Application>