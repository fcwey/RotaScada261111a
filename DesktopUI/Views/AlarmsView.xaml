<UserControl x:Class="DesktopUI.Views.AlarmsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Language="tr-TR">

    <UserControl.Resources>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Alarm satırı: solundaki şerit sınıfın rengindedir -->
        <Style x:Key="AlarmRow" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
            <Setter Property="Margin" Value="0,0,4,3" />
            <Setter Property="Padding" Value="10,0,8,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Bad">
                    <Setter Property="BorderBrush" Value="{StaticResource BadBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Info">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Tablo hücresi -->
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <!-- Onay durumu: bekleyen sarı, onaylanan soluk -->
        <Style x:Key="StateCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="Foreground" Value="{StaticResource WarnTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAcknowledged}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                    <Setter Property="FontWeight" Value="Normal" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Satırdaki Onayla düğmesi: onaylanmış alarmda görünmez -->
        <Style x:Key="AckButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAcknowledged}" Value="True">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- AKTİF ALARMLAR -->
        <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="16,14,12,12">
            <StackPanel>
                <DockPanel Margin="0,0,4,10">
                    <Button DockPanel.Dock="Right" Content="Tümünü Onayla" Command="{Binding AcknowledgeAllCommand}" Height="34" Padding="16,0" Margin="10,0,0,0" />
                    <TextBox DockPanel.Dock="Right" Text="{Binding AckNote, UpdateSourceTrigger=PropertyChanged}" Width="380" Height="34" MaxLength="500" />
                    <TextBlock DockPanel.Dock="Right" Text="Onay notu (isteğe bağlı)" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="AKTİF ALARMLAR" Style="{StaticResource PanelTitle}" />
                        <TextBlock Text="{Binding ActiveSummary}" Foreground="{StaticResource SoftTextBrush}" FontSize="13" Margin="12,0,0,0" />
                    </StackPanel>
                </DockPanel>

                <Grid Margin="13,0,12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Oluştu" Style="{StaticResource LabelText}" />
                    <TextBlock Grid.Column="1" Text="Alarm" Style="{StaticResource LabelText}" />
                    <TextBlock Grid.Column="2" Text="Açıklama" Style="{StaticResource LabelText}" />
                    <TextBlock Grid.Column="3" Text="Sınıf" Style="{StaticResource LabelText}" />
                    <TextBlock Grid.Column="4" Text="Durum" Style="{StaticResource LabelText}" />
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="290" MinHeight="72">
                    <ItemsControl ItemsSource="{Binding ActiveAlarms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AlarmRow}" Height="38">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Time}" Style="{StaticResource Cell}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Tag}" Style="{StaticResource Cell}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Description}" Style="{StaticResource Cell}" ToolTip="{Binding Description}" />
                                        <TextBlock Grid.Column="3" Text="{Binding ClassText}" Style="{StaticResource Cell}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="4" Text="{Binding StateText}" Style="{StaticResource StateCell}" />
                                        <Button Grid.Column="5" Content="Onayla" Style="{StaticResource AckButton}"
                                                Command="{Binding DataContext.AcknowledgeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- GEÇMİŞ -->
        <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="16,14,12,12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,4,10">
                    <Button DockPanel.Dock="Right" Content="Yenile" Command="{Binding RefreshCommand}" Height="34" Padding="16,0" Margin="10,0,0,0" />
                    <TextBox DockPanel.Dock="Right" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="240" Height="34" />
                    <TextBlock DockPanel.Dock="Right" Text="Ara" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="14,0,8,0" />
                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Priorities}" SelectedItem="{Binding SelectedPriority}" DisplayMemberPath="Text" Width="150" Height="34" Margin="10,0,0,0" />
                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}" DisplayMemberPath="Text" Width="150" Height="34" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ALARM GEÇMİŞİ" Style="{StaticResource PanelTitle}" />
                        <TextBlock Text="{Binding HistorySummary}" Foreground="{StaticResource SoftTextBrush}" FontSize="13" Margin="12,0,0,0" />
                    </StackPanel>
                </DockPanel>

                <Grid DockPanel.Dock="Top" Margin="13,0,12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Oluştu" Style="{StaticResource LabelText}" />
                    <TextBlock Grid.Column="1" Text="Alarm" Style="{StaticResource LabelText}" />
                    <TextBlock Grid.Column="2" Text="Açıklama" Style="{StaticResource LabelText}" />
                    <TextBlock Grid.Column="3" Text="Sınıf" Style="{StaticResource LabelText}" />
                    <TextBlock Grid.Column="4" Text="Onaylandı" Style="{StaticResource LabelText}" />
                    <TextBlock Grid.Column="5" Text="Düzeldi" Style="{StaticResource LabelText}" />
                    <TextBlock Grid.Column="6" Text="Süre" Style="{StaticResource LabelText}" />
                    <TextBlock Grid.Column="7" Text="Not" Style="{StaticResource LabelText}" />
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding History}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AlarmRow}" Height="34">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Triggered}" Style="{StaticResource Cell}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Tag}" Style="{StaticResource Cell}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Description}" Style="{StaticResource Cell}" ToolTip="{Binding Description}" />
                                        <TextBlock Grid.Column="3" Text="{Binding ClassText}" Style="{StaticResource Cell}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="4" Text="{Binding Acknowledged}" Style="{StaticResource Cell}" Foreground="{StaticResource SoftTextBrush}" />
                                        <TextBlock Grid.Column="5" Text="{Binding Resolved}" Style="{StaticResource Cell}" Foreground="{StaticResource SoftTextBrush}" />
                                        <TextBlock Grid.Column="6" Text="{Binding Duration}" Style="{StaticResource Cell}" />
                                        <TextBlock Grid.Column="7" Text="{Binding Note}" Style="{StaticResource Cell}" ToolTip="{Binding Note}" Margin="0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>