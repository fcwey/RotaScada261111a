<UserControl x:Class="DesktopUI.Views.AuditLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Language="tr-TR">

    <UserControl.Resources>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <!-- Kayıt satırı: seçilemez; solundaki şerit işlem türünün rengindedir. Liste yalnızca görünen satırları üretir. -->
        <Style x:Key="AuditItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Back" Background="{StaticResource CardBrush}" BorderThickness="3,0,0,0" BorderBrush="{StaticResource AccentBrush}"
                                Margin="0,0,4,3" Padding="10,0,8,0" Height="34">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Time}" Style="{StaticResource Cell}" />
                                <TextBlock Grid.Column="1" Text="{Binding TypeText}" Style="{StaticResource Cell}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="{Binding Description}" Style="{StaticResource Cell}" ToolTip="{Binding Description}" />
                                <TextBlock Grid.Column="3" Text="{Binding Change}" Style="{StaticResource Cell}" Foreground="{StaticResource SoftTextBrush}" ToolTip="{Binding Change}" />
                                <TextBlock Grid.Column="4" Text="{Binding ClientIp}" Style="{StaticResource Cell}" Foreground="{StaticResource MutedBrush}" Margin="0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="Warn">
                                <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource WarnBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Bad">
                                <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource BadBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Border Style="{StaticResource Panel}" Padding="16,14,12,12">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,4,10">
                <Button DockPanel.Dock="Right" Content="Yenile" Command="{Binding RefreshCommand}" Height="34" Padding="16,0" Margin="10,0,0,0" />
                <TextBox DockPanel.Dock="Right" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="260" Height="34" Padding="8,5" />
                <TextBlock DockPanel.Dock="Right" Text="Ara" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="14,0,8,0" />
                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" DisplayMemberPath="Text" Width="270" Height="34" Margin="10,0,0,0" />
                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}" DisplayMemberPath="Text" Width="150" Height="34" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="İŞLEM KAYITLARI" Style="{StaticResource PanelTitle}" />
                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource SoftTextBrush}" FontSize="13" Margin="12,0,0,0" />
                </StackPanel>
            </DockPanel>

            <Grid DockPanel.Dock="Top" Margin="13,0,29,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Zaman" Style="{StaticResource LabelText}" />
                <TextBlock Grid.Column="1" Text="İşlem" Style="{StaticResource LabelText}" />
                <TextBlock Grid.Column="2" Text="Kim, ne yaptı, sonuç" Style="{StaticResource LabelText}" />
                <TextBlock Grid.Column="3" Text="Eski → yeni değer" Style="{StaticResource LabelText}" />
                <TextBlock Grid.Column="4" Text="Bilgisayar" Style="{StaticResource LabelText}" />
            </Grid>

            <ListBox ItemsSource="{Binding Rows}" ItemContainerStyle="{StaticResource AuditItem}"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        </DockPanel>
    </Border>
</UserControl>