<UserControl x:Class="DesktopUI.Views.BatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopUI.Controls"
             Language="tr-TR">

    <UserControl.Resources>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Sonuç etiketi: On yeşil, Warn sarı, Fault kırmızı, Info mavi, diğerleri gri -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="9,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource SoftTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="On">
                    <Setter Property="Background" Value="{StaticResource OkBackBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource OkTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Warn">
                    <Setter Property="Background" Value="{StaticResource WarnBackBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource WarnTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Fault">
                    <Setter Property="Background" Value="{StaticResource BadBackBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource BadTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Info">
                    <Setter Property="Background" Value="{StaticResource NavActiveBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Şarj listesi satırı: kod, sonuç etiketi, reçete ve başlangıç zamanı -->
        <Style x:Key="BatchItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Back" Margin="0,2" Padding="12,9" CornerRadius="6" Background="Transparent">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Tag="{Binding Level}">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="{Binding Code}" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBlock Text="{Binding Recipe}" Foreground="{StaticResource SoftTextBrush}" FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,1,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource CardBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource NavActiveBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Özet alanı: üstte ad, altta değer -->
        <Style x:Key="Field" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,30,8" />
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Adım tablosu: sütun başlığı ve hücre -->
        <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ŞARJ LİSTESİ -->
        <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="14,14,10,10">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="2,0,4,10">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ListMessage}" Foreground="{StaticResource SoftTextBrush}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="ŞARJLAR" Style="{StaticResource PanelTitle}" VerticalAlignment="Center" />
                </DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="2,0,4,8">
                    <Button DockPanel.Dock="Right" Content="Yenile" Command="{Binding RefreshCommand}" Height="34" Padding="14,0" Margin="8,0,0,0" />
                    <ComboBox ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}" DisplayMemberPath="Text" Height="34" />
                </DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="2,0,4,8">
                    <TextBlock Text="Şarj kodu ya da reçete adında ara" Style="{StaticResource LabelText}" Margin="0,0,0,3" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,5" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch}"
                         ItemContainerStyle="{StaticResource BatchItem}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>
        </Border>

        <!-- SEÇİLİ ŞARJ -->
        <Grid Grid.Column="2" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="280" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Özet -->
            <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="18,14,18,8">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Tag="{Binding [ResultLevel]}">
                            <TextBlock Text="{Binding [Result]}" FontSize="13" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                            <Run Text="{Binding [Code], Mode=OneWay}" FontSize="20" FontWeight="Bold" />
                            <Run Text="   " />
                            <Run Text="{Binding [Recipe], Mode=OneWay}" FontSize="15" Foreground="{StaticResource SoftTextBrush}" />
                        </TextBlock>
                    </DockPanel>
                    <WrapPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Başlangıç" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding [Start]}" Style="{StaticResource FieldValue}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Bitiş" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding [End]}" Style="{StaticResource FieldValue}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Süre" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding [Duration]}" Style="{StaticResource FieldValue}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Operatör" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding [Operator]}" Style="{StaticResource FieldValue}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Enerji" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding [Energy]}" Style="{StaticResource FieldValue}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Azot" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding [N2]}" Style="{StaticResource FieldValue}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Amonyak" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding [NH3]}" Style="{StaticResource FieldValue}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="CO₂" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding [CO2]}" Style="{StaticResource FieldValue}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Su" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding [Water]}" Style="{StaticResource FieldValue}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Dolum azotu" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding [FillN2]}" Style="{StaticResource FieldValue}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Acil azot" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding [EmgN2]}" Style="{StaticResource FieldValue}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Şarj ağırlığı (kg)" Style="{StaticResource LabelText}" Margin="0,0,0,2" />
                            <StackPanel Orientation="Horizontal">
                                <!-- İç boşluk dar tutulur; genel stildeki boşluk bu yükseklikte rakamı keser -->
                                <TextBox Text="{Binding LoadKgText, UpdateSourceTrigger=PropertyChanged}" Width="90" Height="32" Padding="8,4" FontSize="14" TextAlignment="Right" />
                                <Button Content="Kaydet" Command="{Binding SaveLoadCommand}" Height="32" Padding="12,0" Margin="8,0,0,0" FontSize="13" />
                            </StackPanel>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding [Note]}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                </StackPanel>
            </Border>

            <!-- Grafik ve notlar -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="400" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="18,14">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
                            <TextBlock Text="SICAKLIK" Style="{StaticResource PanelTitle}" />
                            <TextBlock DockPanel.Dock="Right" Text="Ölçülen" Foreground="{StaticResource SoftTextBrush}" FontSize="12" Margin="6,0,0,0" />
                            <Rectangle DockPanel.Dock="Right" Width="18" Height="3" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="Set" Foreground="{StaticResource SoftTextBrush}" FontSize="12" Margin="6,0,14,0" />
                            <Rectangle DockPanel.Dock="Right" Width="18" Height="2" VerticalAlignment="Center" Stroke="{StaticResource SoftTextBrush}" StrokeDashArray="2 1.5" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding [ChartNote]}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                        <controls:ProfileChart Data="{Binding ChartData}" />
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="16,14,12,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="NOTLAR" Style="{StaticResource PanelTitle}" Margin="0,0,0,8" />
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,4,6">
                            <Button DockPanel.Dock="Right" Content="Ekle" Command="{Binding AddNoteCommand}" Height="34" Padding="14,0" Margin="8,0,0,0" VerticalAlignment="Top" />
                            <TextBox Text="{Binding NewNote, UpdateSourceTrigger=PropertyChanged}" Height="54" Padding="8,5" FontSize="14" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxLength="2000" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding InfoMessage}" Foreground="{StaticResource WarnTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,4,6" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Notes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="10,7" Margin="0,0,4,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Header}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                                <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Adım özetleri, olaylar ve alarmlar -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="400" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="16,14,12,12">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding [StepsNote]}" Foreground="{StaticResource SoftTextBrush}" FontSize="12" />
                            <TextBlock Text="ADIM ÖZETLERİ" Style="{StaticResource PanelTitle}" />
                        </DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="8,0,12,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40*" />
                                <ColumnDefinition Width="66*" />
                                <ColumnDefinition Width="90*" />
                                <ColumnDefinition Width="50*" />
                                <ColumnDefinition Width="56*" />
                                <ColumnDefinition Width="62*" />
                                <ColumnDefinition Width="120*" />
                                <ColumnDefinition Width="58*" />
                                <ColumnDefinition Width="54*" />
                                <ColumnDefinition Width="60*" />
                                <ColumnDefinition Width="66*" />
                                <ColumnDefinition Width="52*" />
                                <ColumnDefinition Width="60*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Adım" Style="{StaticResource Head}" TextAlignment="Left" />
                            <TextBlock Grid.Column="1" Text="Tip" Style="{StaticResource Head}" TextAlignment="Left" />
                            <TextBlock Grid.Column="2" Text="Durum" Style="{StaticResource Head}" TextAlignment="Left" />
                            <TextBlock Grid.Column="3" Text="Süre (dk)" Style="{StaticResource Head}" />
                            <TextBlock Grid.Column="4" Text="Gsoak (dk)" Style="{StaticResource Head}" />
                            <TextBlock Grid.Column="5" Text="Durakl. (dk)" Style="{StaticResource Head}" />
                            <TextBlock Grid.Column="6" Text="Sıcaklık ort. (en az–en çok) °C" Style="{StaticResource Head}" />
                            <TextBlock Grid.Column="7" Text="Kn ort." Style="{StaticResource Head}" />
                            <TextBlock Grid.Column="8" Text="H₂ ort." Style="{StaticResource Head}" />
                            <TextBlock Grid.Column="9" Text="Azot (L)" Style="{StaticResource Head}" />
                            <TextBlock Grid.Column="10" Text="Amonyak (L)" Style="{StaticResource Head}" />
                            <TextBlock Grid.Column="11" Text="CO₂ (L)" Style="{StaticResource Head}" />
                            <TextBlock Grid.Column="12" Text="Enerji (kWh)" Style="{StaticResource Head}" />
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Steps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBrush}" CornerRadius="4" Padding="8,7" Margin="0,0,4,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40*" />
                                                    <ColumnDefinition Width="66*" />
                                                    <ColumnDefinition Width="90*" />
                                                    <ColumnDefinition Width="50*" />
                                                    <ColumnDefinition Width="56*" />
                                                    <ColumnDefinition Width="62*" />
                                                    <ColumnDefinition Width="120*" />
                                                    <ColumnDefinition Width="58*" />
                                                    <ColumnDefinition Width="54*" />
                                                    <ColumnDefinition Width="60*" />
                                                    <ColumnDefinition Width="66*" />
                                                    <ColumnDefinition Width="52*" />
                                                    <ColumnDefinition Width="60*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding StepNo}" Style="{StaticResource Cell}" TextAlignment="Left" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding TypeText}" Style="{StaticResource Cell}" TextAlignment="Left" />
                                                <TextBlock Grid.Column="2" Text="{Binding StateText}" Style="{StaticResource Cell}" TextAlignment="Left" Foreground="{StaticResource SoftTextBrush}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Duration}" Style="{StaticResource Cell}" />
                                                <TextBlock Grid.Column="4" Text="{Binding GsoakWait}" Style="{StaticResource Cell}" />
                                                <TextBlock Grid.Column="5" Text="{Binding Hold}" Style="{StaticResource Cell}" />
                                                <TextBlock Grid.Column="6" Text="{Binding Temp}" Style="{StaticResource Cell}" />
                                                <TextBlock Grid.Column="7" Text="{Binding Kn}" Style="{StaticResource Cell}" />
                                                <TextBlock Grid.Column="8" Text="{Binding H2}" Style="{StaticResource Cell}" />
                                                <TextBlock Grid.Column="9" Text="{Binding N2}" Style="{StaticResource Cell}" />
                                                <TextBlock Grid.Column="10" Text="{Binding NH3}" Style="{StaticResource Cell}" />
                                                <TextBlock Grid.Column="11" Text="{Binding CO2}" Style="{StaticResource Cell}" />
                                                <TextBlock Grid.Column="12" Text="{Binding Energy}" Style="{StaticResource Cell}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="16,14,12,12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,4,0">
                            <TextBlock Text="PLAN OLAYLARI" Style="{StaticResource PanelTitle}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Events}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Foreground="{StaticResource MutedBrush}" FontSize="12" Width="84" />
                                            <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <DockPanel Margin="0,12,0,8">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding [AlarmsNote]}" Foreground="{StaticResource SoftTextBrush}" FontSize="12" />
                                <TextBlock Text="ALARMLAR" Style="{StaticResource PanelTitle}" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Alarms}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBrush}" BorderThickness="3,0,0,0" Padding="8,6" Margin="0,0,0,3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="Bad">
                                                            <Setter Property="BorderBrush" Value="{StaticResource BadBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Info">
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11">
                                                    <Run Text="{Binding Time, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Tag, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding ClassText, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Description}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- Şarj seçili değilken ya da ayrıntı okunamadığında gösterilen açıklama -->
        <Border Grid.Column="2" Padding="24">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasDetail}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding [Empty]}" Foreground="{StaticResource SoftTextBrush}" FontSize="15" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>