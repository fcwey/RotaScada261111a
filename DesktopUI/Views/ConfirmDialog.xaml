<Window x:Class="DesktopUI.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height"
        MinHeight="160"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14">

    <!-- Pencerenin kendisi saydamdır; görünen tek şey bu kutudur. Dıştaki boşluk gölgeye yer bırakır. -->
    <Border Margin="18" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource ButtonLineBrush}" BorderThickness="1" CornerRadius="8"
            MouseLeftButtonDown="OnDragAreaMouseDown">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="4" Opacity="0.55" />
        </Border.Effect>

        <DockPanel>
            <!-- Soldaki şerit sorunun ağırlığını gösterir: sarı uyarı, kırmızı hata, mavi bilgi -->
            <Border x:Name="LevelStripe" DockPanel.Dock="Left" Width="5" CornerRadius="7,0,0,7" Background="{StaticResource WarnBrush}" />

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="22,0,22,20">
                <Button x:Name="YesButton" Content="Evet" Click="OnYesClick" Height="38" MinWidth="110" Padding="20,0" Margin="0,0,10,0" />
                <Button x:Name="NoButton" Content="Hayır" Click="OnNoClick" Height="38" MinWidth="110" Padding="20,0" />
            </StackPanel>

            <StackPanel Margin="22,20,22,22">
                <TextBlock x:Name="CaptionText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock x:Name="MessageText" Foreground="{StaticResource SoftTextBrush}" FontSize="14" TextWrapping="Wrap" LineHeight="21" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>