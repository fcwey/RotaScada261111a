<UserControl x:Class="DesktopUI.Views.ConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20,18" />
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,5" />
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,5" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

            <!-- SCADA sunucusu: bu ekran programının bağlandığı adres -->
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="SCADA SUNUCUSU" Style="{StaticResource PanelTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Adres" Style="{StaticResource RowLabel}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ServerUrl}" Style="{StaticResource RowValue}" />
                        <TextBlock Grid.Row="1" Text="Durum" Style="{StaticResource RowLabel}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ServerState}" Style="{StaticResource RowValue}" />
                        <TextBlock Grid.Row="2" Text="Son veri" Style="{StaticResource RowLabel}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastDataText}" Style="{StaticResource RowValue}" />
                    </Grid>
                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="Sunucu adresi bu programın yanındaki appsettings.json dosyasındaki ServerUrl satırından okunur; değiştirince program yeniden başlatılmalıdır." />
                </StackPanel>
            </Border>

            <!-- PLC: sunucunun fırın PLC'sine bağlantısı -->
            <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="PLC BAĞLANTISI" Style="{StaticResource PanelTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Durum" Style="{StaticResource RowLabel}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PlcState}" Style="{StaticResource RowValue}" />
                        <TextBlock Grid.Row="1" Text="Açıklama" Style="{StaticResource RowLabel}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PlcDetail}" Style="{StaticResource RowValue}" />
                        <TextBlock Grid.Row="2" Text="Arayüz sürümü" Style="{StaticResource RowLabel}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VersionText}" Style="{StaticResource RowValue}" />
                    </Grid>

                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="PLC adresi" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" Width="200" Height="36" Padding="8,6"
                                         VerticalContentAlignment="Center" />
                                <Button Content="Bu adrese bağlan" Command="{Binding ConnectCommand}" Margin="10,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource SoftTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Text="Buradan verilen adres kalıcı değildir; sunucu yeniden başlayınca kendi appsettings.json dosyasındaki Plc:IpAddress adresine döner. Kalıcı değişiklik o dosyadan yapılır." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>