<Window x:Class="DesktopUI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RotaScada - Giriş"
        Width="420" Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}">
    <StackPanel Margin="40,32">
        <TextBlock Text="RotaScada" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource BarBrush}" />
        <TextBlock Text="{Binding ServerUrl}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,24" />

        <TextBlock Text="E-posta" Margin="0,0,0,4" />
        <TextBox x:Name="EmailBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Padding="6" FontSize="15" />

        <TextBlock Text="Şifre" Margin="0,14,0,4" />
        <PasswordBox x:Name="PasswordBox" Padding="6" FontSize="15" KeyDown="PasswordBox_KeyDown" />

        <CheckBox Content="Bu bilgisayarda oturumu açık tut" IsChecked="{Binding RememberMe}" Margin="0,14,0,0" />

        <Button Content="Giriş" Click="LoginButton_Click" IsEnabled="{Binding CanLogin}"
                Margin="0,20,0,0" Padding="0,9" FontSize="15" IsDefault="True" />

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BadBrush}"
                   TextWrapping="Wrap" Margin="0,14,0,0" />
    </StackPanel>
</Window>