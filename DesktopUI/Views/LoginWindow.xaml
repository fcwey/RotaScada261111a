<Window x:Class="DesktopUI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RotaScada - Giriş"
        Width="440" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14">

    <!-- Pencerenin kendisi saydamdır; görünen tek şey bu karttır. Dıştaki boşluk gölgeye yer bırakır. -->
    <Border Margin="18" CornerRadius="8"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource ButtonLineBrush}" BorderThickness="1"
            MouseLeftButtonDown="OnDragAreaMouseDown">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="4" Opacity="0.55" />
        </Border.Effect>

        <Grid>
            <!-- Başlık çubuğu olmadığı için kapatma düğmesi kartın sağ üst köşesindedir -->
            <Button Content="✕" Click="OnCloseClick" ToolTip="Kapat"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="34" Height="30" Padding="0" Margin="0,8,8,0" FontSize="13"
                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" IsTabStop="False" />

            <StackPanel Margin="28,24,28,26">
                <TextBlock Text="RotaScada" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="{Binding ServerUrl}" Style="{StaticResource LabelText}" Margin="0,2,0,22" />

                <TextBlock Text="Kullanıcı adı" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                <TextBox x:Name="UserNameBox" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Şifre (yoksa boş bırakın)" Style="{StaticResource LabelText}" Margin="0,14,0,5" />
                <PasswordBox x:Name="PasswordBox" KeyDown="PasswordBox_KeyDown" />

                <CheckBox Content="Bu bilgisayarda oturumu açık tut" IsChecked="{Binding RememberMe}" Margin="0,16,0,0" />

                <Button Content="Giriş" Click="LoginButton_Click" IsEnabled="{Binding CanLogin}"
                        Margin="0,20,0,0" Height="42" FontSize="15" IsDefault="True" />

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BadBrush}"
                           TextWrapping="Wrap" Margin="0,14,0,0" MinHeight="20" />
            </StackPanel>
        </Grid>
    </Border>
</Window>