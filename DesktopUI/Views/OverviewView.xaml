<UserControl x:Class="DesktopUI.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopUI.Controls">

    <UserControl.Resources>

        <!-- Panel kutusu ve başlığı -->
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Boru: Tag = On ise akış var -->
        <Style x:Key="Pipe" TargetType="Shape">
            <Setter Property="Stroke" Value="#2F3F5C" />
            <Setter Property="StrokeThickness" Value="3" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="On">
                    <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Vana ve fan kanadı: açık/çalışıyor ise dolu yeşil -->
        <Style x:Key="Valve" TargetType="Shape">
            <Setter Property="Fill" Value="{StaticResource PanelBrush}" />
            <Setter Property="Stroke" Value="{StaticResource IdleBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="On">
                    <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                    <Setter Property="Stroke" Value="{StaticResource OkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Fault">
                    <Setter Property="Fill" Value="{StaticResource BadBrush}" />
                    <Setter Property="Stroke" Value="{StaticResource BadBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Cihaz kutusu: motor, pompa, ölçüm kutusu -->
        <Style x:Key="Unit" TargetType="Shape">
            <Setter Property="Fill" Value="{StaticResource PageBrush}" />
            <Setter Property="Stroke" Value="{StaticResource IdleBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="On">
                    <Setter Property="Fill" Value="{StaticResource OkBackBrush}" />
                    <Setter Property="Stroke" Value="{StaticResource OkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Fault">
                    <Setter Property="Fill" Value="{StaticResource BadBackBrush}" />
                    <Setter Property="Stroke" Value="{StaticResource BadBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Isıtıcı ve brülör: çalışırken turuncu -->
        <Style x:Key="Hot" TargetType="Shape">
            <Setter Property="Stroke" Value="#55678A" />
            <Setter Property="StrokeThickness" Value="2.5" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="On">
                    <Setter Property="Stroke" Value="{StaticResource HeatBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Fault">
                    <Setter Property="Stroke" Value="{StaticResource BadBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Yalnızca Tag = On iken görünen parça (alev, malzeme sıcaklığı, aktif adım paneli) -->
        <Style x:Key="OnlyWhenOn" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="On">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Şema yazıları -->
        <Style x:Key="M" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SoftTextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="MValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MSmall" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- Gaz hattındaki değer kutusu -->
        <Style x:Key="ValueBox" TargetType="Border">
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{StaticResource PageBrush}" />
            <Setter Property="BorderBrush" Value="#2F3F5C" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="On">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Fault">
                    <Setter Property="BorderBrush" Value="{StaticResource BadBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Kapak şeridi: On açılabilir (yeşil), Bad açılamaz (kırmızı), Warn kilit aşılmış (sarı) -->
        <Style x:Key="LidStrip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,8,12,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="On">
                    <Setter Property="Background" Value="{StaticResource OkBackBrush}" />
                    <Setter Property="BorderBrush" Value="#2E8B57" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Bad">
                    <Setter Property="Background" Value="{StaticResource BadBackBrush}" />
                    <Setter Property="BorderBrush" Value="#A8383C" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Warn">
                    <Setter Property="Background" Value="{StaticResource WarnBackBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Kilit simgesi: açılamazken kapalı ve kırmızı, açılabilirken açık ve yeşil -->
        <Style x:Key="LockIcon" TargetType="Path">
            <Setter Property="Data" Value="M3,11 H19 V23 H3 Z M6.5,11 V7 A4.5,4.5 0 0 1 15.5,7 V11" />
            <Setter Property="Stroke" Value="{StaticResource MutedBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Bad">
                    <Setter Property="Stroke" Value="{StaticResource BadBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="On">
                    <Setter Property="Data" Value="M3,11 H19 V23 H3 Z M6.5,11 V5 A4.5,4.5 0 0 1 15.5,5 V6.5" />
                    <Setter Property="Stroke" Value="{StaticResource OkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Warn">
                    <Setter Property="Data" Value="M3,11 H19 V23 H3 Z M6.5,11 V5 A4.5,4.5 0 0 1 15.5,5 V6.5" />
                    <Setter Property="Stroke" Value="{StaticResource WarnBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Şemadaki kapak: şeritle aynı rengi alır -->
        <Style x:Key="Lid" TargetType="Shape">
            <Setter Property="Fill" Value="#1B2A45" />
            <Setter Property="Stroke" Value="{StaticResource MutedBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="On">
                    <Setter Property="Fill" Value="{StaticResource OkBackBrush}" />
                    <Setter Property="Stroke" Value="{StaticResource OkBrush}" />
                    <Setter Property="StrokeThickness" Value="2.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Bad">
                    <Setter Property="Fill" Value="{StaticResource BadBackBrush}" />
                    <Setter Property="Stroke" Value="{StaticResource BadBrush}" />
                    <Setter Property="StrokeThickness" Value="2.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Warn">
                    <Setter Property="Fill" Value="{StaticResource WarnBackBrush}" />
                    <Setter Property="Stroke" Value="{StaticResource WarnBrush}" />
                    <Setter Property="StrokeThickness" Value="2.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Şemadaki kısa kapak yazısı -->
        <Style x:Key="LidLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="On">
                    <Setter Property="Foreground" Value="{StaticResource OkTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Bad">
                    <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Warn">
                    <Setter Property="Foreground" Value="{StaticResource WarnTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Pota: kapak açma sınırının üstündeyken sıcak renge boyanır -->
        <Style x:Key="Pot" TargetType="Shape">
            <Setter Property="Fill" Value="{StaticResource PageBrush}" />
            <Setter Property="Stroke" Value="{StaticResource MutedBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Hot">
                    <Setter Property="Fill" Value="#3A1D10" />
                    <Setter Property="Stroke" Value="{StaticResource HeatBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Program durumu kutucuğu -->
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="6,5" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Komut düğmesi -->
        <Style x:Key="Command" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1080*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="592*" />
            </Grid.ColumnDefinitions>

            <!-- SOL SÜTUN -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="68" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Fırın şeması -->
                <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="16,12,16,8">
                    <DockPanel>

                        <!-- Kapak şeridi: açılabilir mi, değilse hangi koşul engelliyor -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource LidStrip}" Tag="{Binding [LidLevel]}" Margin="0,0,0,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Viewbox Width="28" Height="30" Margin="0,0,12,0">
                                        <Canvas Width="22" Height="25">
                                            <Path Style="{StaticResource LockIcon}" Tag="{Binding [LidLevel]}" />
                                        </Canvas>
                                    </Viewbox>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding [LidTitle]}" FontSize="18" FontWeight="Bold" Foreground="White" />
                                        <TextBlock Text="{Binding [LidNote]}" FontSize="12" Foreground="{StaticResource SoftTextBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding LidChecks}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="16,2,0,2">
                                                <TextBlock Text="{Binding Mark}" FontSize="15" FontWeight="Bold" Width="16" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level}" Value="On">
                                                                    <Setter Property="Foreground" Value="{StaticResource OkTextBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="Bad">
                                                                    <Setter Property="Foreground" Value="#FF8A8E" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Text}" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>

                        <Viewbox Stretch="Uniform">
                            <Canvas Width="1048" Height="564">

                                <!-- Boru hatları -->
                                <Path Style="{StaticResource Pipe}" Tag="{Binding [N2Valve]}" Data="M112,230 H300" />
                                <Path Style="{StaticResource Pipe}" Tag="{Binding [NH3Valve]}" Data="M112,275 H300" />
                                <Path Style="{StaticResource Pipe}" Tag="{Binding [CO2Valve]}" Data="M112,320 H300" />
                                <Path Style="{StaticResource Pipe}" Tag="{Binding [WaterPump]}" Data="M112,365 H300" />
                                <Path Style="{StaticResource Pipe}" Tag="{Binding [ExtN2Valve]}" Data="M112,410 H300" />
                                <Path Style="{StaticResource Pipe}" Tag="{Binding [EmgN2Valve]}" Data="M112,455 H300" />
                                <Path Style="{StaticResource Pipe}" Tag="{Binding [GasIn]}" Data="M300,455 V140 H402 V178" />
                                <Path Style="{StaticResource Pipe}" Tag="{Binding [VacValve]}" Data="M790,96 V340" />
                                <Path Style="{StaticResource Pipe}" Tag="{Binding [Drain]}" Data="M820,96 V60 H880 V96" />
                                <Path Style="{StaticResource Pipe}" Tag="{Binding [Pcv]}" Data="M820,96 H880" />
                                <Path Style="{StaticResource Pipe}" Tag="{Binding [Outlet]}" Data="M655,178 V96 H820" />
                                <Path Style="{StaticResource Pipe}" Tag="{Binding [ToFlare]}" Data="M880,96 H930" />

                                <!-- Gaz hatları: adlar -->
                                <TextBlock Canvas.Left="20" Canvas.Top="221" Text="Azot" Style="{StaticResource M}" />
                                <TextBlock Canvas.Left="20" Canvas.Top="266" Text="Amonyak" Style="{StaticResource M}" />
                                <TextBlock Canvas.Left="20" Canvas.Top="311" Text="CO₂" Style="{StaticResource M}" />
                                <TextBlock Canvas.Left="20" Canvas.Top="356" Text="Su" Style="{StaticResource M}" />
                                <TextBlock Canvas.Left="20" Canvas.Top="401" Text="Harici azot" Style="{StaticResource M}" />
                                <TextBlock Canvas.Left="20" Canvas.Top="446" Text="Acil azot" Style="{StaticResource M}" />

                                <!-- Gaz hatları: vanalar -->
                                <Path Style="{StaticResource Valve}" Tag="{Binding [N2Valve]}" Data="M131,223 L149,237 V223 L131,237 Z" />
                                <Path Style="{StaticResource Valve}" Tag="{Binding [NH3Valve]}" Data="M131,268 L149,282 V268 L131,282 Z" />
                                <Path Style="{StaticResource Valve}" Tag="{Binding [CO2Valve]}" Data="M131,313 L149,327 V313 L131,327 Z" />
                                <Path Style="{StaticResource Valve}" Tag="{Binding [WaterPump]}" Data="M131,358 L149,372 V358 L131,372 Z" />
                                <Path Style="{StaticResource Valve}" Tag="{Binding [ExtN2Valve]}" Data="M131,403 L149,417 V403 L131,417 Z" />
                                <Path Style="{StaticResource Valve}" Tag="{Binding [EmgN2Valve]}" Data="M131,448 L149,462 V448 L131,462 Z" />

                                <!-- Gaz hatları: değer kutuları -->
                                <TextBlock Canvas.Left="172" Canvas.Top="199" Width="100" TextAlignment="Center" Text="MFC" Style="{StaticResource MSmall}" />
                                <Border Canvas.Left="172" Canvas.Top="217" Style="{StaticResource ValueBox}" Tag="{Binding [N2Mfc]}">
                                    <TextBlock Text="{Binding [N2Flow]}" Style="{StaticResource MValue}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Canvas.Left="172" Canvas.Top="262" Style="{StaticResource ValueBox}" Tag="{Binding [NH3Mfc]}">
                                    <TextBlock Text="{Binding [NH3Flow]}" Style="{StaticResource MValue}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Canvas.Left="172" Canvas.Top="307" Style="{StaticResource ValueBox}" Tag="{Binding [CO2Valve]}">
                                    <TextBlock Text="{Binding [CO2Text]}" Style="{StaticResource M}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Canvas.Left="172" Canvas.Top="352" Style="{StaticResource ValueBox}" Tag="{Binding [WaterPump]}">
                                    <TextBlock Text="{Binding [WaterText]}" Style="{StaticResource M}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Canvas.Left="172" Canvas.Top="397" Style="{StaticResource ValueBox}" Tag="{Binding [ExtN2Valve]}">
                                    <TextBlock Text="{Binding [ExtN2Text]}" Style="{StaticResource M}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Canvas.Left="172" Canvas.Top="442" Style="{StaticResource ValueBox}" Tag="{Binding [EmgN2Valve]}">
                                    <TextBlock Text="{Binding [EmgN2Text]}" Style="{StaticResource M}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Su soğutma cihazları -->
                                <Border Canvas.Left="20" Canvas.Top="14" Width="272" Height="104" CornerRadius="6"
                                        Background="{StaticResource PageBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14,10">
                                    <StackPanel>
                                        <TextBlock Text="SU SOĞUTMA (EŞANJÖR)" Style="{StaticResource MSmall}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <DockPanel Margin="0,0,0,5">
                                            <Ellipse Width="10" Height="10" Style="{StaticResource Valve}" Tag="{Binding [PreFill]}" VerticalAlignment="Center" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding [PreFillText]}" Style="{StaticResource M}" />
                                            <TextBlock Text="Ön dolum vanası" Style="{StaticResource M}" Margin="10,0,0,0" />
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,5">
                                            <Ellipse Width="10" Height="10" Style="{StaticResource Valve}" Tag="{Binding [MainWater]}" VerticalAlignment="Center" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding [MainWaterText]}" Style="{StaticResource M}" />
                                            <TextBlock Text="Ana su vanaları (2)" Style="{StaticResource M}" Margin="10,0,0,0" />
                                        </DockPanel>
                                        <DockPanel>
                                            <Ellipse Width="10" Height="10" Style="{StaticResource Valve}" Tag="{Binding [DrainPump]}" VerticalAlignment="Center" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding [DrainPumpText]}" Style="{StaticResource M}" />
                                            <TextBlock Text="Boşaltma pompası" Style="{StaticResource M}" Margin="10,0,0,0" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Fırın gövdesi, pota ve kapak; kapak açılabilirlik durumunun rengini alır -->
                                <Rectangle Canvas.Left="400" Canvas.Top="200" Width="260" Height="330" RadiusX="6" RadiusY="6" Fill="#111C30" Stroke="#55678A" StrokeThickness="2" />
                                <Path Style="{StaticResource Pot}" Tag="{Binding [PotLevel]}" Data="M440,225 H620 V490 Q620,505 605,505 H455 Q440,505 440,490 Z" />
                                <Rectangle Canvas.Left="390" Canvas.Top="178" Width="280" Height="22" RadiusX="3" RadiusY="3" Style="{StaticResource Lid}" Tag="{Binding [LidLevel]}" />
                                <Rectangle Canvas.Left="384" Canvas.Top="196" Width="292" Height="6" RadiusX="2" RadiusY="2" Fill="#B8327E" />

                                <!-- Kapağın yanındaki kilit ve kısa durum yazısı -->
                                <Path Canvas.Left="684" Canvas.Top="156" Style="{StaticResource LockIcon}" Tag="{Binding [LidLevel]}" />
                                <TextBlock Canvas.Left="712" Canvas.Top="158" Text="Kapak" Style="{StaticResource MSmall}" />
                                <TextBlock Canvas.Left="712" Canvas.Top="172" Text="{Binding [LidShort]}" Style="{StaticResource LidLabel}" Tag="{Binding [LidLevel]}" />

                                <!-- Isıtma bölgeleri -->
                                <Path Style="{StaticResource Hot}" Tag="{Binding [Heater]}" Data="M414,240 L430,252 L414,264 L430,276 L414,288 L430,300 L414,312 L430,324 L414,336 L430,348" />
                                <Path Style="{StaticResource Hot}" Tag="{Binding [Heater]}" Data="M630,240 L646,252 L630,264 L646,276 L630,288 L646,300 L630,312 L646,324 L630,336 L646,348" />
                                <Path Style="{StaticResource Hot}" Tag="{Binding [Heater]}" Data="M414,380 L430,392 L414,404 L430,416 L414,428 L430,440 L414,452 L430,464 L414,476 L430,488" />
                                <Path Style="{StaticResource Hot}" Tag="{Binding [Heater]}" Data="M630,380 L646,392 L630,404 L646,416 L630,428 L646,440 L630,452 L646,464 L630,476 L646,488" />

                                <TextBlock Canvas.Left="306" Canvas.Top="274" Width="84" TextAlignment="Right" Text="Üst bölge" Style="{StaticResource MSmall}" />
                                <TextBlock Canvas.Left="306" Canvas.Top="289" Width="84" TextAlignment="Right" Text="{Binding [HeatUstTemp]}" Style="{StaticResource MValue}" FontSize="14" />
                                <TextBlock Canvas.Left="306" Canvas.Top="309" Width="84" TextAlignment="Right" Text="{Binding [HeatUstOut]}" FontSize="12" Foreground="#FFB877" />
                                <TextBlock Canvas.Left="306" Canvas.Top="414" Width="84" TextAlignment="Right" Text="Alt bölge" Style="{StaticResource MSmall}" />
                                <TextBlock Canvas.Left="306" Canvas.Top="429" Width="84" TextAlignment="Right" Text="{Binding [HeatAltTemp]}" Style="{StaticResource MValue}" FontSize="14" />
                                <TextBlock Canvas.Left="306" Canvas.Top="449" Width="84" TextAlignment="Right" Text="{Binding [HeatAltOut]}" FontSize="12" Foreground="#FFB877" />

                                <!-- Sirkülasyon fanı -->
                                <Rectangle Canvas.Left="512" Canvas.Top="128" Width="36" Height="50" RadiusX="4" RadiusY="4" Style="{StaticResource Unit}" Tag="{Binding [CircFan]}" />
                                <TextBlock Canvas.Left="512" Canvas.Top="144" Width="36" TextAlignment="Center" Text="M" FontWeight="Bold" Style="{StaticResource M}" />
                                <Path Style="{StaticResource Valve}" Tag="{Binding [CircFan]}" StrokeThickness="2" Data="M530,200 V250 M530,250 L496,240 V260 Z M530,250 L564,240 V260 Z" />
                                <TextBlock Canvas.Left="440" Canvas.Top="270" Width="180" TextAlignment="Center" Text="{Binding [CircText]}" Style="{StaticResource MSmall}" Foreground="{StaticResource SoftTextBrush}" />

                                <!-- Pota içi -->
                                <TextBlock Canvas.Left="440" Canvas.Top="296" Width="180" TextAlignment="Center" Text="{Binding [PotaTemp]}" FontSize="38" FontWeight="Bold" Foreground="White" />
                                <TextBlock Canvas.Left="440" Canvas.Top="348" Width="180" TextAlignment="Center" Text="{Binding [PotaSet]}" Style="{StaticResource MSmall}" />
                                <Rectangle Canvas.Left="468" Canvas.Top="378" Width="124" Height="112" RadiusX="3" RadiusY="3" Stroke="#55678A" StrokeDashArray="5 4" />
                                <Path Data="M468,412 H592 M468,456 H592" Stroke="#55678A" />
                                <TextBlock Canvas.Left="468" Canvas.Top="426" Width="124" TextAlignment="Center" Text="{Binding [MaterialText]}"
                                           Tag="{Binding [Material]}" Style="{StaticResource OnlyWhenOn}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />

                                <!-- Kapak üstü ölçümler -->
                                <Path Data="M428,162 V178 M458,162 V178 M488,162 V178" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5" />
                                <Ellipse Canvas.Left="416" Canvas.Top="138" Width="24" Height="24" Fill="{StaticResource PageBrush}" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5" />
                                <Ellipse Canvas.Left="446" Canvas.Top="138" Width="24" Height="24" Fill="{StaticResource PageBrush}" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5" />
                                <Ellipse Canvas.Left="476" Canvas.Top="138" Width="24" Height="24" Style="{StaticResource Unit}" Tag="{Binding [H2Sensor]}" />
                                <TextBlock Canvas.Left="416" Canvas.Top="143" Width="24" TextAlignment="Center" Text="PT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Canvas.Left="446" Canvas.Top="143" Width="24" TextAlignment="Center" Text="TC" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Canvas.Left="476" Canvas.Top="143" Width="24" TextAlignment="Center" Text="H₂" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Canvas.Left="336" Canvas.Top="113" Width="100" TextAlignment="Right" Text="{Binding [PressureMimic]}" Style="{StaticResource MValue}" />
                                <TextBlock Canvas.Left="470" Canvas.Top="92" Text="{Binding [H2Mimic]}" Style="{StaticResource MValue}" />
                                <TextBlock Canvas.Left="470" Canvas.Top="109" Text="{Binding [H2Line]}" Style="{StaticResource MSmall}" FontSize="10" />

                                <!-- Eşanjör -->
                                <Path Data="M580,168 V178 M626,168 V178" Stroke="{StaticResource IdleBrush}" StrokeThickness="2" />
                                <Rectangle Canvas.Left="566" Canvas.Top="128" Width="74" Height="40" RadiusX="4" RadiusY="4" Style="{StaticResource Unit}" Tag="{Binding [Exchanger]}" />
                                <TextBlock Canvas.Left="566" Canvas.Top="132" Width="74" TextAlignment="Center" Text="Eşanjör" FontSize="11" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Canvas.Left="566" Canvas.Top="148" Width="74" TextAlignment="Center" Text="{Binding [ExchWater]}" Style="{StaticResource MSmall}" />

                                <!-- Soğutma havası: klepe ve fan -->
                                <Rectangle Canvas.Left="660" Canvas.Top="220" Width="40" Height="20" Fill="#111C30" Stroke="#55678A" StrokeThickness="1.5" />
                                <Path Style="{StaticResource Valve}" Tag="{Binding [Damper]}" StrokeThickness="3" Data="M680,221 V239" />
                                <TextBlock Canvas.Left="708" Canvas.Top="222" Text="{Binding [DamperText]}" Style="{StaticResource M}" />
                                <Rectangle Canvas.Left="660" Canvas.Top="482" Width="22" Height="16" Fill="#111C30" Stroke="#55678A" StrokeThickness="1.5" />
                                <Ellipse Canvas.Left="681" Canvas.Top="466" Width="48" Height="48" Style="{StaticResource Unit}" Tag="{Binding [CoolFan]}" />
                                <Path Data="M705,490 L692,476 M705,490 L722,482 M705,490 L700,508" Stroke="{StaticResource MutedBrush}" StrokeThickness="2" />
                                <Rectangle Canvas.Left="729" Canvas.Top="478" Width="34" Height="24" RadiusX="3" RadiusY="3" Style="{StaticResource Unit}" Tag="{Binding [CoolFan]}" />
                                <TextBlock Canvas.Left="729" Canvas.Top="482" Width="34" TextAlignment="Center" Text="M" FontWeight="Bold" Style="{StaticResource M}" />
                                <TextBlock Canvas.Left="672" Canvas.Top="528" Text="{Binding [CoolFanText]}" Style="{StaticResource M}" />

                                <!-- Vakum ve hidrolik standı -->
                                <Path Style="{StaticResource Valve}" Tag="{Binding [VacValve]}" Data="M781,213 L799,227 H781 L799,213 Z" />
                                <TextBlock Canvas.Left="806" Canvas.Top="212" Text="Vakum vanası" Style="{StaticResource M}" />
                                <Rectangle Canvas.Left="760" Canvas.Top="340" Width="60" Height="40" RadiusX="4" RadiusY="4" Style="{StaticResource Unit}" Tag="{Binding [VacPump]}" />
                                <TextBlock Canvas.Left="760" Canvas.Top="353" Width="60" TextAlignment="Center" Text="VAKUM" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SoftTextBrush}" />
                                <Rectangle Canvas.Left="830" Canvas.Top="340" Width="56" Height="40" RadiusX="4" RadiusY="4" Style="{StaticResource Unit}" Tag="{Binding [Hydraulic]}" />
                                <TextBlock Canvas.Left="830" Canvas.Top="353" Width="56" TextAlignment="Center" Text="HİDR." FontSize="10" FontWeight="Bold" Foreground="{StaticResource SoftTextBrush}" />
                                <Path Data="M750,390 H896 M762,390 V404 M884,390 V404" Stroke="#55678A" StrokeThickness="2" />
                                <TextBlock Canvas.Left="750" Canvas.Top="412" Text="{Binding [VacPumpText]}" Style="{StaticResource M}" />
                                <TextBlock Canvas.Left="750" Canvas.Top="430" Text="{Binding [HydraulicText]}" Style="{StaticResource M}" />

                                <!-- Basınç kontrol ve tahliye -->
                                <Path Style="{StaticResource Valve}" Tag="{Binding [Pcv]}" Data="M841,89 L859,103 V89 L841,103 Z" />
                                <TextBlock Canvas.Left="790" Canvas.Top="108" Width="120" TextAlignment="Center" Text="Basınç kontrol" Style="{StaticResource M}" />
                                <Path Style="{StaticResource Valve}" Tag="{Binding [Drain]}" Data="M841,53 L859,67 V53 L841,67 Z" />
                                <TextBlock Canvas.Left="790" Canvas.Top="30" Width="120" TextAlignment="Center" Text="Tahliye" Style="{StaticResource M}" />

                                <!-- Yakma kulesi -->
                                <Path Data="M908,112 V520 M952,112 V520 M900,520 H960" Stroke="#55678A" StrokeThickness="2" />
                                <Path Data="M908,112 H952 M908,214 H952 M908,316 H952 M908,418 H952 M908,112 L952,214 L908,316 L952,418 L908,520" Stroke="#55678A" StrokeThickness="1.2" />
                                <Rectangle Canvas.Left="916" Canvas.Top="84" Width="28" Height="28" RadiusX="3" RadiusY="3" Fill="{StaticResource PageBrush}" Style="{StaticResource Hot}" StrokeThickness="1.5" Tag="{Binding [Burner]}" />
                                <Path Tag="{Binding [Burner]}" Style="{StaticResource OnlyWhenOn}" Fill="{StaticResource HeatBrush}"
                                      Data="M930,30 C942,46 946,56 940,68 C937,74 934,78 930,80 C926,78 923,74 920,68 C914,56 918,46 930,30 Z" />
                                <TextBlock Canvas.Left="962" Canvas.Top="48" Text="{Binding [BurnerText]}" Style="{StaticResource M}" />
                                <TextBlock Canvas.Left="870" Canvas.Top="530" Width="120" TextAlignment="Center" Text="Yakma kulesi" Style="{StaticResource M}" />

                                <!-- Açıklama -->
                                <StackPanel Canvas.Left="20" Canvas.Top="532" Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource OkBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="çalışıyor / açık" Style="{StaticResource MSmall}" Margin="6,0,16,0" />
                                    <Ellipse Width="10" Height="10" Stroke="{StaticResource IdleBrush}" StrokeThickness="1.5" VerticalAlignment="Center" />
                                    <TextBlock Text="duruyor / kapalı" Style="{StaticResource MSmall}" Margin="6,0,16,0" />
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource BadBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="arıza" Style="{StaticResource MSmall}" Margin="6,0,16,0" />
                                    <Rectangle Width="24" Height="3" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="akış var" Style="{StaticResource MSmall}" Margin="6,0,0,0" />
                                </StackPanel>

                            </Canvas>
                        </Viewbox>
                    </DockPanel>
                </Border>

                <!-- Komutlar -->
                <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="16,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Başlat" Command="{Binding StartCommand}" Style="{StaticResource Command}" />
                            <Button Content="Beklet" Command="{Binding HoldCommand}" Style="{StaticResource Command}" />
                            <Button Content="Devam" Command="{Binding ResumeCommand}" Style="{StaticResource Command}" />
                            <Button Content="Stop" Command="{Binding StopCommand}" Style="{StaticResource Command}"
                                    Background="{StaticResource BadBackBrush}" BorderBrush="#A8383C" Foreground="{StaticResource BadTextBrush}" />
                            <Rectangle Width="1" Height="30" Fill="{StaticResource LineBrush}" Margin="4,0,14,0" />
                            <Button Content="Vakum Onay" Command="{Binding VacuumOkCommand}" Style="{StaticResource Command}" />
                            <Button Content="Soğutmaya Geç" Command="{Binding SkipToCoolingCommand}" Style="{StaticResource Command}" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding [Hint]}" Foreground="{StaticResource WarnTextBrush}" FontSize="13" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding [CmdResult]}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Aktif alarmlar -->
                <Border Grid.Row="4" Style="{StaticResource Panel}" Padding="16,12" MinHeight="150">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="AKTİF ALARMLAR" Style="{StaticResource PanelTitle}" />
                            <TextBlock Text="{Binding [AlarmSummary]}" Foreground="{StaticResource SoftTextBrush}" FontSize="13" Margin="12,0,0,0" />
                        </StackPanel>
                        <Grid Height="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Saat" Style="{StaticResource LabelText}" Margin="11,0,0,0" />
                            <TextBlock Grid.Column="1" Text="Alarm" Style="{StaticResource LabelText}" />
                            <TextBlock Grid.Column="2" Text="Açıklama" Style="{StaticResource LabelText}" />
                            <TextBlock Grid.Column="3" Text="Sınıf" Style="{StaticResource LabelText}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Alarms}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="32" Margin="0,0,0,2" Background="{StaticResource CardBrush}" BorderThickness="3,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="Bad">
                                                        <Setter Property="BorderBrush" Value="{StaticResource BadBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Info">
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="97" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Time}" Margin="8,0,0,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Tag}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding ClassText}" FontWeight="SemiBold" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- SAĞ SÜTUN -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" MinHeight="200" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Program durumu -->
                <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="12,14,12,16">
                    <StackPanel>
                        <DockPanel Margin="6,0,6,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding [StepInfo]}" Foreground="{StaticResource SoftTextBrush}" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="PROGRAM DURUMU" Style="{StaticResource PanelTitle}" />
                        </DockPanel>
                        <UniformGrid Columns="2">
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="Sıcaklık (°C)" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="{Binding [Temp]}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="{Binding [TempSet]}" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="Basınç (mbar)" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="{Binding [Pressure]}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="{Binding [PressureSet]}" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="Kn" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="{Binding [Kn]}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="{Binding [KnNote]}" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="Hidrojen" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="{Binding [H2]}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="{Binding [H2Set]}" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Aktif adımın reçetedeki değerleri: yalnızca program yürürken görünür -->
                        <Border Margin="6,6,6,0" Padding="14,10,14,4" CornerRadius="6" Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                Tag="{Binding [StepPanel]}" Style="{StaticResource OnlyWhenOn}">
                            <StackPanel>
                                <TextBlock Text="{Binding [StepTitle]}" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding ActiveStepItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,22,6">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource LabelText}" FontSize="11" />
                                                <TextBlock Text="{Binding Value}" FontSize="15" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <DockPanel Margin="6,10,6,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding [StepTime]}" FontSize="13" />
                            <TextBlock Text="Adım süresi" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                        </DockPanel>
                        <ProgressBar Margin="6,0" Height="8" Minimum="0" Maximum="100" Value="{Binding StepProgress, Mode=OneWay}"
                                     Background="{StaticResource LineBrush}" Foreground="{StaticResource AccentBrush}" BorderThickness="0" />
                    </StackPanel>
                </Border>

                <!-- Program eğrisi -->
                <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="18,14">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
                            <TextBlock Text="PROGRAM EĞRİSİ" Style="{StaticResource PanelTitle}" />
                            <TextBlock DockPanel.Dock="Right" Text="Ölçülen" Foreground="{StaticResource SoftTextBrush}" FontSize="12" Margin="6,0,0,0" />
                            <Rectangle DockPanel.Dock="Right" Width="18" Height="3" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="İlerleme" Foreground="{StaticResource SoftTextBrush}" FontSize="12" Margin="6,0,14,0" />
                            <Rectangle DockPanel.Dock="Right" Width="18" Height="4" Fill="{StaticResource OkTextBrush}" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="Plan" Foreground="{StaticResource SoftTextBrush}" FontSize="12" Margin="6,0,14,0" />
                            <Rectangle DockPanel.Dock="Right" Width="18" Height="2" VerticalAlignment="Center" Stroke="{StaticResource SoftTextBrush}" StrokeDashArray="2 1.5" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding [ChartNote]}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        <controls:ProfileChart Data="{Binding ChartData}" />
                    </DockPanel>
                </Border>

                <!-- Şarj toplamları -->
                <Border Grid.Row="4" Style="{StaticResource Panel}" Padding="18,14,18,12">
                    <StackPanel>
                        <TextBlock Text="ŞARJ TOPLAMLARI" Style="{StaticResource PanelTitle}" Margin="0,0,0,8" />
                        <UniformGrid Columns="2">
                            <DockPanel Margin="0,0,14,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding [Energy]}" />
                                <TextBlock Text="Enerji" Foreground="{StaticResource MutedBrush}" />
                            </DockPanel>
                            <DockPanel Margin="14,0,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding [Power]}" />
                                <TextBlock Text="Anlık güç" Foreground="{StaticResource MutedBrush}" />
                            </DockPanel>
                            <DockPanel Margin="0,0,14,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding [N2Total]}" />
                                <TextBlock Text="Azot" Foreground="{StaticResource MutedBrush}" />
                            </DockPanel>
                            <DockPanel Margin="14,0,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding [NH3Total]}" />
                                <TextBlock Text="Amonyak" Foreground="{StaticResource MutedBrush}" />
                            </DockPanel>
                            <DockPanel Margin="0,0,14,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding [CO2Total]}" />
                                <TextBlock Text="CO₂" Foreground="{StaticResource MutedBrush}" />
                            </DockPanel>
                            <DockPanel Margin="14,0,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding [WaterTotal]}" />
                                <TextBlock Text="Su" Foreground="{StaticResource MutedBrush}" />
                            </DockPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Canlı veri yokken değerlerin üstünü örten uyarı -->
        <Border Background="#D90A111E" CornerRadius="8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLive}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="CANLI VERİ YOK" FontSize="30" FontWeight="Bold" Foreground="{StaticResource BadBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Sunucu ya da PLC bağlantısı yok; değerler güncel olmadığı için gösterilmiyor." Foreground="{StaticResource SoftTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>