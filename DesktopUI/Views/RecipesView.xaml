<UserControl x:Class="DesktopUI.Views.RecipesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopUI.Controls"
             Language="tr-TR">

    <UserControl.Resources>

        <!-- Adım tipi renkleri: grafikteki bölgelerle aynı -->
        <SolidColorBrush x:Key="VacuumBrush" Color="#5B8DEF" />
        <SolidColorBrush x:Key="HeatingBrush" Color="#FF9F45" />
        <SolidColorBrush x:Key="CoolingBrush" Color="#3CC8D9" />
        <SolidColorBrush x:Key="VacuumBackBrush" Color="#151F38" />
        <SolidColorBrush x:Key="HeatingBackBrush" Color="#261C12" />
        <SolidColorBrush x:Key="CoolingBackBrush" Color="#10252B" />

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Adım tablosundaki sayı kutusu -->
        <Style x:Key="Cell" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Adım tablosunun sütun başlığı -->
        <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <!-- Başlık alanı: üstte etiket, altta kutu -->
        <Style x:Key="Field" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,16,12" />
        </Style>

        <!-- Satırdaki küçük düğme -->
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="3,0" />
        </Style>

        <!-- Adım satırının zemini: adım tipine göre renk tonu -->
        <Style x:Key="StepRow" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StepType}" Value="1">
                    <Setter Property="Background" Value="{StaticResource VacuumBackBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StepType}" Value="2">
                    <Setter Property="Background" Value="{StaticResource HeatingBackBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StepType}" Value="3">
                    <Setter Property="Background" Value="{StaticResource CoolingBackBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Adım satırının solundaki renk şeridi -->
        <Style x:Key="StepStripe" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource IdleBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StepType}" Value="1">
                    <Setter Property="Background" Value="{StaticResource VacuumBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StepType}" Value="2">
                    <Setter Property="Background" Value="{StaticResource HeatingBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StepType}" Value="3">
                    <Setter Property="Background" Value="{StaticResource CoolingBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Reçete listesi satırı -->
        <Style x:Key="RecipeItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Back" Margin="0,2" Padding="12,9" CornerRadius="6" Background="Transparent">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Info}" Style="{StaticResource LabelText}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource CardBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource NavActiveBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- REÇETE LİSTESİ -->
        <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="12,14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="REÇETELER" Style="{StaticResource PanelTitle}" Margin="6,0,0,10" />

                <!-- Süzgeç: tip ve ada göre arama -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" IsEnabled="{Binding IsListEnabled}">
                    <ComboBox ItemsSource="{Binding TypeFilters}" DisplayMemberPath="Text" SelectedValuePath="Value" SelectedValue="{Binding TypeFilter}" />
                    <TextBlock Text="Ada göre ara" Style="{StaticResource LabelText}" Margin="2,8,0,4" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8,6" />
                </StackPanel>

                <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="0,10,0,0">
                    <Button Content="Yeni" Command="{Binding NewCommand}" Margin="0,0,4,0" />
                    <Button Content="Kopyala" Command="{Binding CopyCommand}" Margin="4,0" Padding="8,0" />
                    <Button Content="Sil" Command="{Binding DeleteCommand}" Margin="4,0,0,0" />
                </UniformGrid>

                <TextBlock DockPanel.Dock="Bottom" Text="Başka reçeteye geçmek için önce Kaydet ya da Vazgeç."
                           Foreground="{StaticResource WarnTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="6,8,6,0"
                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />

                <!-- Liste soluklaşmaz; değişiklik varken yalnızca tıklanamaz -->
                <ListBox ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}"
                         IsHitTestVisible="{Binding IsListEnabled}" Focusable="False"
                         ItemContainerStyle="{StaticResource RecipeItem}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>
        </Border>

        <!-- Reçete seçilmemişken -->
        <Border Grid.Column="2" Style="{StaticResource Panel}">
            <TextBlock Text="Soldan bir reçete seçin ya da Yeni ile reçete oluşturun."
                       Foreground="{StaticResource MutedBrush}" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- DÜZENLEME -->
        <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="20,16"
                Visibility="{Binding HasEditor, Converter={StaticResource BoolToVis}}">
            <DockPanel>

                <!-- Alt satır: kaydet, kontrol, başlat ve sonuç mesajı -->
                <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Content="Kaydet" Command="{Binding SaveCommand}" Height="42" Padding="22,0" Margin="0,0,8,0" />
                        <Button Content="Vazgeç" Command="{Binding RevertCommand}" Height="42" Padding="22,0" Margin="0,0,24,0" />
                        <Button Content="PLC'de Kontrol Et" Command="{Binding ValidateCommand}" Height="42" Padding="22,0" Margin="0,0,8,0" />
                        <Button Content="Başlat" Command="{Binding StartCommand}" Height="42" Padding="28,0"
                                Background="{StaticResource OkBackBrush}" BorderBrush="#1F6B3C" />
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" Margin="20,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SoftTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageLevel}" Value="Ok">
                                        <Setter Property="Foreground" Value="{StaticResource OkTextBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MessageLevel}" Value="Bad">
                                        <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>

                <!-- Teorik sıcaklık eğrisi: yazdıkça güncellenir -->
                <Border DockPanel.Dock="Bottom" Height="270" Margin="0,14,0,0" Padding="14,10" CornerRadius="6" Background="{StaticResource CardBrush}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,6">
                            <TextBlock Text="TEORİK SICAKLIK EĞRİSİ" Style="{StaticResource PanelTitle}" FontSize="12" />
                            <TextBlock DockPanel.Dock="Right" Text="Soğutma" Style="{StaticResource LabelText}" Margin="6,0,0,0" />
                            <Rectangle DockPanel.Dock="Right" Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="{StaticResource CoolingBrush}" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="Isıtma" Style="{StaticResource LabelText}" Margin="6,0,14,0" />
                            <Rectangle DockPanel.Dock="Right" Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="{StaticResource HeatingBrush}" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="Vakum" Style="{StaticResource LabelText}" Margin="6,0,14,0" />
                            <Rectangle DockPanel.Dock="Right" Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="{StaticResource VacuumBrush}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ProfileNote}" Style="{StaticResource LabelText}" Margin="0,2,0,0" />
                        <controls:ProfileChart Data="{Binding ChartData}" />
                    </DockPanel>
                </Border>

                <!-- Başlık ve adımlar: düzenleme yetkisi yoksa kilitli -->
                <DockPanel IsEnabled="{Binding CanEdit}">

                    <TextBlock DockPanel.Dock="Top" Text="{Binding EditorTitle}" Style="{StaticResource PanelTitle}" Margin="0,0,0,12" />

                    <WrapPanel DockPanel.Dock="Top">
                        <StackPanel Style="{StaticResource Field}" Width="300">
                            <TextBlock Text="Reçete adı (en fazla 30 karakter)" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}" Width="150">
                            <TextBlock Text="Tip" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding RecipeTypes}" DisplayMemberPath="Text" SelectedValuePath="Value" SelectedValue="{Binding RecipeType}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}" Width="120">
                            <TextBlock Text="Basınç seti (mbar)" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding PressureSetPoint}" TextAlignment="Right" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}" Width="150">
                            <TextBlock Text="Gsoak termokuplu" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding GsoakSensors}" DisplayMemberPath="Text" SelectedValuePath="Value" SelectedValue="{Binding GsoakTcId}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}" Width="130" Visibility="{Binding ShowCO2Period, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="CO₂ periyodu (dk)" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding CO2Period}" TextAlignment="Right" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}" Width="170" Visibility="{Binding ShowPressureMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Basınç modu" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding PressureModes}" DisplayMemberPath="Text" SelectedValuePath="Value" SelectedValue="{Binding PressureMode}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}" Width="150" Visibility="{Binding ShowPressureModeTime, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Tazeleme aralığı (dk)" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding PressureModeTime}" TextAlignment="Right" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}" Width="150" Visibility="{Binding ShowPressureModeTemp, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Geçiş sıcaklığı (°C)" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding PressureModeTemp}" TextAlignment="Right" />
                        </StackPanel>
                    </WrapPanel>

                    <!-- Adım tablosu başlığı -->
                    <Grid DockPanel.Dock="Top" Margin="0,4,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="124" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="No" Style="{StaticResource Head}" />
                        <TextBlock Grid.Column="1" Text="Adım tipi" Style="{StaticResource Head}" />
                        <TextBlock Grid.Column="2" Text="Vakum seti mbar" Style="{StaticResource Head}" />
                        <TextBlock Grid.Column="3" Text="Zaman aşımı dk" Style="{StaticResource Head}" />
                        <TextBlock Grid.Column="4" Text="Sıcaklık °C" Style="{StaticResource Head}" />
                        <TextBlock Grid.Column="5" Text="Süre dk" Style="{StaticResource Head}" />
                        <TextBlock Grid.Column="6" Text="Gsoak °C" Style="{StaticResource Head}" />
                        <TextBlock Grid.Column="7" Text="Azot L/h" Style="{StaticResource Head}" />
                        <TextBlock Grid.Column="8" Text="Amonyak L/h" Style="{StaticResource Head}" />
                        <TextBlock Grid.Column="9" Text="CO₂ %" Style="{StaticResource Head}" />
                        <TextBlock Grid.Column="10" Text="Su" Style="{StaticResource Head}" />
                        <TextBlock Grid.Column="11" Text="H₂ oto" Style="{StaticResource Head}" />
                        <TextBlock Grid.Column="12" Text="H₂ seti %" Style="{StaticResource Head}" />
                        <TextBlock Grid.Column="13" Text="Fan %" Style="{StaticResource Head}" />
                    </Grid>

                    <Button DockPanel.Dock="Bottom" Content="Adım Ekle" Command="{Binding AddStepCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />

                    <!-- Adım satırları -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="42" Margin="0,0,0,3" CornerRadius="5" Style="{StaticResource StepRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="124" />
                                                <ColumnDefinition Width="84" />
                                                <ColumnDefinition Width="84" />
                                                <ColumnDefinition Width="84" />
                                                <ColumnDefinition Width="84" />
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="84" />
                                                <ColumnDefinition Width="84" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="6" CornerRadius="5,0,0,5" HorizontalAlignment="Left" Style="{StaticResource StepStripe}" />
                                            <TextBlock Grid.Column="0" Text="{Binding StepNo}" FontSize="15" FontWeight="Bold" Margin="6,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" Margin="3,0" Height="32" VerticalAlignment="Center"
                                                      ItemsSource="{Binding DataContext.StepTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      DisplayMemberPath="Text" SelectedValuePath="Value" SelectedValue="{Binding StepType}" />

                                            <TextBox Grid.Column="2" Style="{StaticResource Cell}" Text="{Binding VacSetPoint}" Visibility="{Binding IsVacuum, Converter={StaticResource BoolToVis}}" />
                                            <TextBox Grid.Column="3" Style="{StaticResource Cell}" Text="{Binding VacTimeout}" Visibility="{Binding IsVacuum, Converter={StaticResource BoolToVis}}" />
                                            <TextBox Grid.Column="4" Style="{StaticResource Cell}" Text="{Binding TargetTemp}" Visibility="{Binding ShowTemp, Converter={StaticResource BoolToVis}}" />
                                            <TextBox Grid.Column="5" Style="{StaticResource Cell}" Text="{Binding StepTime}" Visibility="{Binding IsHeating, Converter={StaticResource BoolToVis}}" />
                                            <TextBox Grid.Column="6" Style="{StaticResource Cell}" Text="{Binding GSoak}" Visibility="{Binding IsHeating, Converter={StaticResource BoolToVis}}" />
                                            <TextBox Grid.Column="7" Style="{StaticResource Cell}" Text="{Binding N2Flow}" Visibility="{Binding ShowN2, Converter={StaticResource BoolToVis}}" />
                                            <TextBox Grid.Column="8" Style="{StaticResource Cell}" Text="{Binding NH3Flow}" Visibility="{Binding ShowNH3, Converter={StaticResource BoolToVis}}" />
                                            <TextBox Grid.Column="9" Style="{StaticResource Cell}" Text="{Binding CO2Perc}" Visibility="{Binding ShowCO2, Converter={StaticResource BoolToVis}}" />
                                            <CheckBox Grid.Column="10" IsChecked="{Binding WaterOn}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowWater, Converter={StaticResource BoolToVis}}" />
                                            <CheckBox Grid.Column="11" IsChecked="{Binding H2Auto}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowH2, Converter={StaticResource BoolToVis}}" />
                                            <TextBox Grid.Column="12" Style="{StaticResource Cell}" Text="{Binding H2SetPercent, StringFormat=0.0}" Visibility="{Binding ShowH2Set, Converter={StaticResource BoolToVis}}" />
                                            <TextBox Grid.Column="13" Style="{StaticResource Cell}" Text="{Binding FanSpeed}" Visibility="{Binding ShowFan, Converter={StaticResource BoolToVis}}" />

                                            <StackPanel Grid.Column="14" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <Button Content="Yukarı" Style="{StaticResource RowButton}"
                                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <Button Content="Aşağı" Style="{StaticResource RowButton}"
                                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <Button Content="Sil" Style="{StaticResource RowButton}"
                                                        Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>