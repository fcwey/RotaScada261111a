<Window x:Class="DesktopUI.Views.ReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Şarj raporu"
        Width="1040" Height="820"
        MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PageBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Kapat" Click="OnCloseClick" Height="38" Padding="22,0" IsCancel="True" />
            <Button DockPanel.Dock="Right" Content="Yazdır" Click="OnPrintClick" Height="38" Padding="22,0" Margin="0,0,10,0" />
            <Button DockPanel.Dock="Right" Content="Dosyaya Kaydet" Click="OnSaveClick" Height="38" Padding="22,0" Margin="0,0,10,0" />
            <TextBlock x:Name="MessageText" Foreground="{StaticResource SoftTextBrush}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Rapor sabit genişlikli yazı tipiyle gösterilir; sütunlar hizalı kalsın diye satır kaydırılmaz -->
        <TextBox x:Name="ReportBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Consolas" FontSize="13" Padding="14,12"
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>