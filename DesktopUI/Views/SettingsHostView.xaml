<UserControl x:Class="DesktopUI.Views.SettingsHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- Sekme başlığı: seçili olanın altında mavi çizgi olur -->
        <Style x:Key="TabHeader" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource SoftTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Back" Padding="18,9" Margin="0,0,6,0" CornerRadius="6,6,0,0" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0,0,0,3">
                            <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource SoftTextBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource CardBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource PanelBrush}" />
                                <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Title" Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ListBox Grid.Row="0" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                 ItemContainerStyle="{StaticResource TabHeader}"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <ContentControl Grid.Row="2" Content="{Binding CurrentContent}" />
    </Grid>
</UserControl>