<UserControl x:Class="DesktopUI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Language="tr-TR">

    <UserControl.Resources>

        <!-- Parametreler gruplarına göre listelenir; sırayı görünüm modeli belirler -->
        <CollectionViewSource x:Key="ParamGroups" Source="{Binding Rows}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupName" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Parametre satırı: kutudaki değer yazılmamışsa çerçevesi mavi olur -->
        <Style x:Key="ParamRow" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="12,7,8,7" />
            <Setter Property="Margin" Value="0,0,6,4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- PLC'deki değer: varsayılandan farklıysa turuncu -->
        <Style x:Key="CurrentValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource HeatBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Güvenlik etiketi: yalnızca güvenlik parametresinde görünür -->
        <Style x:Key="SafetyTag" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Background" Value="{StaticResource WarnBackBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSafety}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Satırdaki Yaz ve Geri Al düğmeleri: yalnızca kutuda yazılmamış değer varken görünür -->
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Visibility" Value="Hidden" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Yedek listesi satırı -->
        <Style x:Key="BackupItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Back" Margin="0,2" Padding="10,7" CornerRadius="6" Background="Transparent">
                            <StackPanel>
                                <TextBlock Text="{Binding Time}" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Note}" Foreground="{StaticResource SoftTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource CardBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource NavActiveBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="440" />
        </Grid.ColumnDefinitions>

        <!-- PLC PARAMETRELERİ -->
        <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="16,14,10,12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,6,10">
                    <Button DockPanel.Dock="Right" Content="Yenile" Command="{Binding RefreshCommand}" Height="34" Padding="16,0" Margin="10,0,0,0" />
                    <TextBox DockPanel.Dock="Right" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="260" Height="34" Padding="8,5" />
                    <TextBlock DockPanel.Dock="Right" Text="Ara" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="PLC PARAMETRELERİ" Style="{StaticResource PanelTitle}" VerticalAlignment="Center" />
                </DockPanel>

                <Grid DockPanel.Dock="Top" Margin="13,0,26,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="170" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Parametre" Style="{StaticResource LabelText}" />
                    <TextBlock Grid.Column="1" Text="İzinli aralık" Style="{StaticResource LabelText}" TextAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="Varsayılan" Style="{StaticResource LabelText}" TextAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="PLC'de" Style="{StaticResource LabelText}" TextAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="Yeni değer" Style="{StaticResource LabelText}" TextAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="Birim" Style="{StaticResource LabelText}" Margin="8,0,0,0" />
                </Grid>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding ParamMessage}" Foreground="{StaticResource WarnTextBrush}" FontSize="13" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Source={StaticResource ParamGroups}}">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource SoftTextBrush}" FontSize="13" FontWeight="SemiBold" Margin="2,12,0,6" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ParamRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="170" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                                <Border Style="{StaticResource SafetyTag}">
                                                    <TextBlock Text="GÜVENLİK" Foreground="{StaticResource WarnTextBrush}" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,10,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding RangeText}" Foreground="{StaticResource SoftTextBrush}" FontSize="13" TextAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding DefaultText}" Foreground="{StaticResource SoftTextBrush}" FontSize="13" TextAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding Value}" Style="{StaticResource CurrentValue}" />

                                        <!-- İç boşluk dar tutulur; genel stildeki boşluk bu yükseklikte rakamı keser -->
                                        <TextBox Grid.Column="4" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}"
                                                 Height="32" Padding="8,4" FontSize="14" Margin="12,0,0,0" TextAlignment="Right" VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="5" Text="{Binding Unit}" Foreground="{StaticResource SoftTextBrush}" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="Geri Al" Style="{StaticResource RowButton}"
                                                    Command="{Binding DataContext.RevertCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Yaz" Style="{StaticResource RowButton}"
                                                    Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- YEDEKLER -->
        <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="16,14,12,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,4,8">
                    <TextBlock Text="PARAMETRE YEDEKLERİ" Style="{StaticResource PanelTitle}" Margin="0,0,0,8" />
                    <TextBlock Text="Yedek notu (isteğe bağlı)" Style="{StaticResource LabelText}" Margin="0,0,0,3" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Yedek Al" Command="{Binding CreateBackupCommand}" Height="34" Padding="14,0" Margin="8,0,0,0" />
                        <TextBox Text="{Binding BackupNote, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,5" MaxLength="200" />
                    </DockPanel>
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}"
                         ItemContainerStyle="{StaticResource BackupItem}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                <StackPanel Grid.Row="2" Margin="0,8,4,8">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="PLC ile Karşılaştır" Command="{Binding CompareCommand}" Height="34" Padding="14,0" />
                        <Button Content="Geri Yükle" Command="{Binding RestoreCommand}" Height="34" Padding="14,0" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding BackupMessage}" Foreground="{StaticResource WarnTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding ResultTitle}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ResultLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource SoftTextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,4,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>