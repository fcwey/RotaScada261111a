<UserControl x:Class="DesktopUI.Views.TrendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:scott="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             Language="tr-TR">

    <UserControl.Resources>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- SEÇİMLER -->
        <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="16,14">
            <StackPanel>
                <TextBlock Text="ARALIK" Style="{StaticResource PanelTitle}" Margin="0,0,0,8" />
                <TextBlock Text="Süre" Style="{StaticResource LabelText}" Margin="0,0,0,3" />
                <ComboBox ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}" DisplayMemberPath="Text" Height="34" />
                <TextBlock Text="Ya da şarj" Style="{StaticResource LabelText}" Margin="0,10,0,3" />
                <ComboBox ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch}" DisplayMemberPath="Text" Height="34" />
                <DockPanel Margin="0,12,0,0">
                    <Button DockPanel.Dock="Right" Content="Yenile" Command="{Binding RefreshCommand}" Height="34" Padding="16,0" />
                    <CheckBox Content="Canlı izle" IsChecked="{Binding FollowLive}" VerticalAlignment="Center" />
                </DockPanel>

                <TextBlock Text="SOL EKSEN · SICAKLIK (°C)" Style="{StaticResource PanelTitle}" Margin="0,24,0,8" />
                <ItemsControl ItemsSource="{Binding TempTags}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,8">
                                <Rectangle DockPanel.Dock="Right" Width="18" Height="4" Fill="{Binding Swatch}" VerticalAlignment="Center" />
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="SAĞ EKSEN" Style="{StaticResource PanelTitle}" Margin="0,18,0,8" />
                <ComboBox ItemsSource="{Binding RightGroups}" SelectedItem="{Binding SelectedRightGroup}" DisplayMemberPath="Text" Height="34" />

                <TextBlock Margin="0,24,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                           Text="Tekerlek yakınlaştırır, sol tuşla sürükleme kaydırır, orta tuş görünümü sığdırır. Canlı izle açıkken görünüm her yenilemede sığdırılır." />
            </StackPanel>
        </Border>

        <!-- GRAFİK -->
        <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="16,14">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CursorText}" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="TREND" Style="{StaticResource PanelTitle}" />
                </DockPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0" />

                <!-- Gösterge: her serinin rengi, adı ve fare altındaki değeri -->
                <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Series}" Margin="0,8,0,0" MinHeight="44">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="10,5" Margin="0,0,8,6" MinWidth="130">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="14" Height="4" Fill="{Binding Swatch}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource SoftTextBrush}" FontSize="12" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ValueText}" FontSize="15" FontWeight="SemiBold" MinHeight="20" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <scott:WpfPlot x:Name="Chart" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>