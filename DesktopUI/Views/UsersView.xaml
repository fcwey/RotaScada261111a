<UserControl x:Class="DesktopUI.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Language="tr-TR">

    <UserControl.Resources>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Kullanıcı listesi satırı -->
        <Style x:Key="UserItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Back" Margin="0,2" Padding="12,8" CornerRadius="6" Background="Transparent">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Foreground="{StaticResource BadBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding UserName}" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBlock Text="{Binding FullName}" Foreground="{StaticResource SoftTextBrush}" FontSize="13" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding RolesText}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource CardBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource NavActiveBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rol kutucuğu satırı: ad ve altında açıklama -->
        <DataTemplate x:Key="RoleTemplate">
            <Border Background="{StaticResource CardBrush}" CornerRadius="5" Padding="10,7" Margin="0,0,4,4">
                <CheckBox IsChecked="{Binding IsChecked}" VerticalContentAlignment="Center">
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </CheckBox>
            </Border>
        </DataTemplate>

        <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
            <Setter Property="Margin" Value="0,10,0,3" />
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="440" />
        </Grid.ColumnDefinitions>

        <!-- KULLANICI LİSTESİ -->
        <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="14,14,10,10">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="2,0,4,8">
                    <Button DockPanel.Dock="Right" Content="Yenile" Command="{Binding RefreshCommand}" Height="32" Padding="14,0" FontSize="13" />
                    <TextBlock Text="KULLANICILAR" Style="{StaticResource PanelTitle}" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                         ItemContainerStyle="{StaticResource UserItem}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>
        </Border>

        <!-- SEÇİLİ KULLANICI -->
        <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="18,14,12,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,6,10">
                    <TextBlock Text="SEÇİLİ KULLANICI" Style="{StaticResource PanelTitle}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding SelectedTitle}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,6,0" IsEnabled="{Binding HasSelection}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Rolleri Kaydet" Command="{Binding SaveRolesCommand}" Height="36" Padding="18,0" />
                        <Button Content="{Binding ToggleActiveText}" Command="{Binding ToggleActiveCommand}" Height="36" Padding="18,0" Margin="10,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="Yeni şifre (boş bırakılırsa hesap şifresiz olur)" Style="{StaticResource FormLabel}" Margin="0,16,0,3" />
                    <StackPanel Orientation="Horizontal">
                        <PasswordBox x:Name="ResetPasswordBox" Width="240" />
                        <Button Content="Şifreyi Değiştir" Click="OnResetPasswordClick" Height="36" Padding="18,0" Margin="10,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource WarnTextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0" MinHeight="18" />
                </StackPanel>

                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Roller" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedRoles}" ItemTemplate="{StaticResource RoleTemplate}" />
                    </ScrollViewer>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- YENİ KULLANICI -->
        <Border Grid.Column="4" Style="{StaticResource Panel}" Padding="18,14,12,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,6,0">
                    <TextBlock Text="YENİ KULLANICI" Style="{StaticResource PanelTitle}" />
                    <TextBlock Text="Kullanıcı adı (en az 2 karakter)" Style="{StaticResource FormLabel}" />
                    <TextBox Text="{Binding NewUserName, UpdateSourceTrigger=PropertyChanged}" />
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,5,0">
                            <TextBlock Text="Ad (isteğe bağlı)" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding NewFirstName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="5,0,0,0">
                            <TextBlock Text="Soyad (isteğe bağlı)" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding NewLastName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="Şifre (boş bırakılabilir)" Style="{StaticResource FormLabel}" />
                    <PasswordBox x:Name="NewPasswordBox" />
                    <TextBlock Text="Roller" Style="{StaticResource FormLabel}" Margin="0,14,0,6" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,6,0">
                    <Button Content="Kullanıcıyı Aç" Click="OnCreateUserClick" Height="36" Padding="18,0" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding NewMessage}" Foreground="{StaticResource WarnTextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0" MinHeight="18" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding NewRoles}" ItemTemplate="{StaticResource RoleTemplate}" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>