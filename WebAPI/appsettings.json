{
  // ---------------------------------------------------------------
  // PLC bağlantısı
  // ---------------------------------------------------------------
  "Plc": {
    "IpAddress": "192.168.0.1"
  },

  // ---------------------------------------------------------------
  // Giriş token'ı
  // AccessTokenExpiration dakikadır. 5256000 = 10 yıl (pratikte sınırsız).
  // SecurityKey buraya YAZILMAZ; appsettings.Local.json içinde durur.
  // ---------------------------------------------------------------
  "TokenOption": {
    "Audience": "www.rfurnace.com",
    "Issuer": "www.rfurnace.com",
    "AccessTokenExpiration": 5256000
  },

  // ---------------------------------------------------------------
  // Alarm sınıfı ezme (isteğe bağlı)
  // Sahada PLC'de (DB_Alarm.AlmClass) bir alarmın sınıfını değiştirirseniz
  // aynısını buraya yazın. Yalnızca varsayılandan farklı olanlar yazılır.
  // Biçim: "alarm no": sınıf   (0 uyarı, 1 duraklat, 2 güvenli durdur)
  // Kullanmak için aşağıdaki bloğun başındaki // işaretlerini kaldırın.
  // ---------------------------------------------------------------
  // "AlarmClasses": {
  //   "22": 2,
  //   "31": 1
  // },

  // ---------------------------------------------------------------
  // İLERİDE EKLENEBİLECEKLER
  // Aşağıdakilerin kodda henüz karşılığı yok; yazsanız da etkisi olmaz.
  // İstediğinizi söylerseniz koda bağlarım.
  // ---------------------------------------------------------------
