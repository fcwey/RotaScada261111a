{
  // ---------------------------------------------------------------
  // PLC bağlantısı
  // ---------------------------------------------------------------
  "Plc": {
    "IpAddress": "192.168.61.209"
  },
  // ---------------------------------------------------------------
  // Günlük bakım: eski verinin temizlenmesi ve yedekleme
  // RunHour'dan sonra günde bir kez çalışır; bilgisayar kapalıysa açılınca yapar.
  // Saklama süreleri gündür, 0 = hiç silme.
  // ---------------------------------------------------------------
  "Maintenance": {
    "RunHour": 3,
    "IdleLogKeepDays": 90, // Fırın beklemedeyken alınan ölçümler
    "BatchLogKeepDays": 0, // Şarja ait ölçümler (şarj raporunun grafiği)
    "AlarmKeepDays": 0, // Kapanmış alarmlar
    "AuditKeepDays": 0, // İşlem kayıtları

    "BackupEnabled": true,
    "MysqldumpPath": "C:\\Program Files\\MySQL\\MySQL Server 8.4\\bin\\mysqldump.exe",
    "BackupFolder": "D:\\RotaScadaYedek", // Veritabanının durduğu diskten FARKLI bir disk
    "BackupKeepCount": 30 // Son 30 günün yedeği saklanır
  },
  // ---------------------------------------------------------------
  // Giriş token'ı
  // AccessTokenExpiration dakikadır. 5256000 = 10 yıl (pratikte sınırsız).
  // SecurityKey buraya YAZILMAZ; appsettings.Local.json içinde durur.
  // ---------------------------------------------------------------
  "TokenOption": {
    "Audience": "www.rfurnace.com",
    "Issuer": "www.rfurnace.com",
    "AccessTokenExpiration": 5256000
  },

  // ---------------------------------------------------------------
  // Alarm sınıfı ezme (isteğe bağlı)
  // Sahada PLC'de (DB_Alarm.AlmClass) bir alarmın sınıfını değiştirirseniz
  // aynısını buraya yazın. Yalnızca varsayılandan farklı olanlar yazılır.
  // Biçim: "alarm no": sınıf   (0 uyarı, 1 duraklat, 2 güvenli durdur)
  // Kullanmak için aşağıdaki bloğun başındaki // işaretlerini kaldırın.
  // ---------------------------------------------------------------
  // "AlarmClasses": {
  //   "22": 2,
  //   "31": 1
  // },

